API_PORT=4000
API_BASE_URL=http://localhost:4000

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4000

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_RAW_BUCKET=reels-raw
R2_PROCESSED_BUCKET=reels-processed
R2_PUBLIC_BASE_URL=https://pub-your-public-r2-url.r2.dev

ELASTICSEARCH_NODE=https://your-elasticsearch-endpoint
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key
ELASTICSEARCH_INDEX_VIDEOS=reels-videos

RABBITMQ_URL=amqps://USER:PASSWORD@HOST/VHOST
RABBITMQ_EXCHANGE=reels.events
RABBITMQ_VIDEO_QUEUE=video-processing.queue
RABBITMQ_EVENTS_QUEUE=recommendation-events.queue

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_TMP_DIR=/tmp/reels-worker
